# PostgreSQL connection string used by the volunteer registration API.
# Hosted databases that require TLS should append ?sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Set to true when your provider requires TLS (e.g. most hosted databases).
DATABASE_SSL=false

# Password used to sign in at /admin. Keep this private.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Separate password for the manual attendee registration portal at /volunteer-admin.
VOLUNTEER_ADMIN_PASSWORD=change-me-to-a-different-long-random-password

# Resend API key used to email the registration code after signup.
RESEND_API_KEY=re_your_api_key_here

# Verified sender address in Resend, e.g. "Ogbor Youth Tech Fest <events@example.com>".
EMAIL_FROM=Ogbor Youth Tech Fest <events@example.com>
